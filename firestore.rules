rules_version = '2';
// ============================================================
// トレジャーカードマップ セキュリティルール
// 「だれが・何を・どんな形で」書けるかをサーバー側で決める。
// アプリ側をいじられても、ここを通らない書き込みはすべて拒否される。
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通のチェック ----------
    function signedIn() { return request.auth != null; }
    // メール確認済みの人だけ（Googleログインは自動で確認済み）
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // 運営者：Firebaseの管理画面で admins/{自分のuid} を作った人だけ（アプリからは作れない）
    function isAdmin() { return verified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // URLっぽい文字・タグを禁止（スパム／いたずら対策）
    function safeText(v) { return !v.lower().matches('(?s).*(https?://|www\\.|<|>).*'); }
    // 見えない文字・文字の向きを変える特殊文字（なりすまし・表示崩し）を禁止。改行はOK
    function noHidden(v) { return !v.matches('(?s).*[\\x{0000}-\\x{0009}\\x{000B}-\\x{001F}\\x{007F}\\x{200B}-\\x{200F}\\x{202A}-\\x{202E}\\x{2060}-\\x{2069}\\x{FEFF}].*'); }
    // 電話番号・メールアドレスの書きこみを禁止（ほかの人の個人情報を守る）
    function noPII(v) { return !v.matches('(?s).*(0[0-9]{1,4}-?[0-9]{1,4}-?[0-9]{4}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}).*'); }
    // ふつうの文章チェックをまとめたもの
    function okText(v) { return safeText(v) && noHidden(v) && noPII(v); }
    // 運営・公式になりすますニックネームを禁止
    function okNick(v) { return okText(v) && !v.matches('.*@.*')
      && !v.lower().matches('.*(運営|公式|管理者|admin|official|support|bandai|バンダイ|トレジャーカードマップ).*'); }
    function exactKeys(d, keys) { return d.keys().hasAll(keys) && d.keys().hasOnly(keys); }
    function rlPath() { return /databases/$(database)/documents/rateLimits/$(request.auth.uid); }
    // 同じ書き込みの中で rateLimits の時刻が「今」に更新されているか
    function stamped(field) { return getAfter(rlPath()).data.get(field, null) == request.time; }
    // 47都道府県
    function myNickname() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname; }
    // JPEG写真（data URL）だけ受け付ける
    function jpeg(v, max) { return v is string && v.size() <= max && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'); }
    function prefs() { return ['北海道','青森県','岩手県','宮城県','秋田県','山形県','福島県','茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県','新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県','三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県','鳥取県','島根県','岡山県','広島県','山口県','徳島県','香川県','愛媛県','高知県','福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県','沖縄県']; }

    // ---------- ユーザー（ニックネーム） ----------
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if verified() && isMe(uid)
        && exactKeys(request.resource.data, ['nickname', 'createdAt'])
        && str(request.resource.data.nickname, 1, 20) && okNick(request.resource.data.nickname)
        && request.resource.data.createdAt == request.time;
      allow update: if verified() && isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname'])
        && str(request.resource.data.nickname, 1, 20) && okNick(request.resource.data.nickname);
      // アカウント削除のときだけ、自分のニックネームを消せる
      allow delete: if isMe(uid);
    }

    // ---------- 連投制限 ----------
    // 報告とお店の登録は5秒に1回（ボタン連打・荒らし対策）、写真は1分に1回まで
    match /rateLimits/{uid} {
      function cooled(field, sec) {
        return resource == null || !(field in resource.data)
          || request.time > resource.data[field] + duration.value(sec, 's');
      }
      function stampOk(field, sec) {
        return !(field in request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys())
          || (request.resource.data[field] == request.time && cooled(field, sec));
      }
      allow read: if isMe(uid);
      allow create, update: if verified() && isMe(uid)
        && request.resource.data.keys().hasOnly(['lastReport', 'lastStore', 'lastPhoto'])
        && stampOk('lastReport', 5) && stampOk('lastStore', 5) && stampOk('lastPhoto', 60);
      allow delete: if false;
    }

    // ---------- お店 ----------
    match /stores/{storeId} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasAll(['name', 'lat', 'lng', 'address', 'pref', 'createdBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'lat', 'lng', 'address', 'pref', 'createdBy', 'createdAt', 'pioneer'])
        // 開拓者（最初に登録した人）の名前は、本人のニックネームと同じときだけOK（なりすまし防止）
        && (!('pioneer' in request.resource.data)
            || request.resource.data.pioneer == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname)
        && str(request.resource.data.name, 1, 40) && safeText(request.resource.data.name) && noHidden(request.resource.data.name)
        && str(request.resource.data.address, 0, 120) && safeText(request.resource.data.address) && noHidden(request.resource.data.address)
        && request.resource.data.pref in prefs()
        && request.resource.data.lat is number && request.resource.data.lat > 20 && request.resource.data.lat < 46
        && request.resource.data.lng is number && request.resource.data.lng > 122 && request.resource.data.lng < 154
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && stamped('lastStore');
      // 変更はだれもできない。削除は運営者だけ（ウソのお店の削除）
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- 在庫の報告 ----------
    match /reports/{reportId} {
      function d() { return request.resource.data; }
      function counterPlusOne(field, sub) {
        return d().diff(resource.data).affectedKeys().hasOnly([field])
          && d()[field] == resource.data.get(field, 0) + 1
          && resource.data.uid != request.auth.uid
          && !exists(/databases/$(database)/documents/reports/$(reportId)/$(sub)/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/reports/$(reportId)/$(sub)/$(request.auth.uid));
      }

      allow read: if true;
      allow create: if verified()
        && d().keys().hasAll(['storeId', 'uid', 'nickname', 'product', 'setCode', 'status', 'saleType', 'note', 'likes', 'flags', 'createdAt'])
        && d().keys().hasOnly(['storeId', 'uid', 'nickname', 'product', 'setCode', 'status', 'saleType', 'note', 'likes', 'flags', 'createdAt', 'itemName', 'limit'])
        // 購入制限（例：1人3パックまで）は任意・決まった値だけ
        && (!('limit' in d()) || d().limit in ['none', 'p1', 'p2', 'p3', 'p5', 'p10', 'box1'])
        // 商品名（例：最強の戦士）は任意・30文字まで・URL不可
        && (!('itemName' in d()) || (str(d().itemName, 1, 30) && okText(d().itemName)))
        && d().uid == request.auth.uid
        && d().nickname == myNickname()
        && d().storeId is string && exists(/databases/$(database)/documents/stores/$(d().storeId))
        && d().product in ['booster', 'extra', 'premium', 'starter', 'other']
        && d().status in ['in', 'low', 'out', 'soon', 'na']
        && d().saleType in ['pack', 'box', 'lottery', 'other']
        && d().setCode is string && d().setCode.matches('^[A-Z0-9-]{0,12}$')
        && str(d().note, 0, 100) && okText(d().note)
        && d().likes == 0 && d().flags == 0
        && d().createdAt == request.time
        && stamped('lastReport');
      // 自分の報告以外は書き換え不可。他人ができるのは👍と通報の+1だけ（1人1回）
      // 「まだあった」「もうなかった」も1人1回の+1だけ
      allow update: if verified() && (counterPlusOne('likes', 'likes') || counterPlusOne('flags', 'flags')
        || counterPlusOne('still', 'stills') || counterPlusOne('gone', 'gones'));
      allow delete: if (verified() && resource.data.uid == request.auth.uid) || isAdmin();

      match /likes/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.likes
             == get(/databases/$(database)/documents/reports/$(reportId)).data.likes + 1;
        allow update, delete: if false;
      }
      match /flags/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.flags
             == get(/databases/$(database)/documents/reports/$(reportId)).data.flags + 1;
        allow update, delete: if false;
      }
      match /stills/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.get('still', 0)
             == get(/databases/$(database)/documents/reports/$(reportId)).data.get('still', 0) + 1;
        allow update, delete: if false;
      }
      match /gones/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.get('gone', 0)
             == get(/databases/$(database)/documents/reports/$(reportId)).data.get('gone', 0) + 1;
        allow update, delete: if false;
      }
    }

    // ---------- お店の写真（一覧用の小さい写真） ----------
    match /photos/{photoId} {
      function d() { return request.resource.data; }
      function dataPath() { return /databases/$(database)/documents/photoData/$(photoId); }
      allow read: if true;
      allow create: if verified()
        && exactKeys(d(), ['storeId', 'thumb', 'w', 'h', 'uid', 'nickname', 'flags', 'createdAt'])
        && d().uid == request.auth.uid
        && d().nickname == myNickname()
        && d().storeId is string && exists(/databases/$(database)/documents/stores/$(d().storeId))
        && jpeg(d().thumb, 40000)
        && d().w is int && d().w >= 1 && d().w <= 1280
        && d().h is int && d().h >= 1 && d().h <= 1280
        && d().flags == 0
        && d().createdAt == request.time
        && existsAfter(dataPath())
        && stamped('lastPhoto');
      // 他人ができるのは通報の+1だけ（1人1回）。自分の写真は削除できる
      allow update: if verified()
        && d().diff(resource.data).affectedKeys().hasOnly(['flags'])
        && d().flags == resource.data.flags + 1
        && resource.data.uid != request.auth.uid
        && !exists(/databases/$(database)/documents/photos/$(photoId)/flags/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/photos/$(photoId)/flags/$(request.auth.uid));
      allow delete: if (verified() && resource.data.uid == request.auth.uid) || isAdmin();

      match /flags/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/photos/$(photoId)).data.flags
             == get(/databases/$(database)/documents/photos/$(photoId)).data.flags + 1;
        allow update, delete: if false;
      }
    }

    // ---------- お店の写真（大きい写真） ----------
    match /photoData/{photoId} {
      allow read: if true;
      // 同じ書き込みで自分の photos を新しく作るときだけ
      allow create: if verified()
        && exactKeys(request.resource.data, ['uid', 'data'])
        && request.resource.data.uid == request.auth.uid
        && jpeg(request.resource.data.data, 300000)
        && !exists(/databases/$(database)/documents/photos/$(photoId))
        && getAfter(/databases/$(database)/documents/photos/$(photoId)).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if (verified() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- 運営者の名簿（読むのは本人だけ。書きこみはFirebaseの管理画面からだけ） ----------
    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    // ---------- 「これから行く」：2時間ごとの人数（だれが行くかは本人以外には見えない） ----------
    match /goings/{bucketId} {
      function slotNow() { return int(request.time.toMillis() / 7200000); }
      function markAfter() { return existsAfter(/databases/$(database)/documents/goings/$(bucketId)/marks/$(request.auth.uid)); }
      allow read: if true;
      allow create: if verified()
        && exactKeys(request.resource.data, ['storeId', 'slot', 'n'])
        && request.resource.data.storeId is string && request.resource.data.storeId.size() <= 64
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && request.resource.data.slot == slotNow()
        && bucketId == request.resource.data.storeId + '_' + string(slotNow())
        && request.resource.data.n == 1 && markAfter();
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1
        && !exists(/databases/$(database)/documents/goings/$(bucketId)/marks/$(request.auth.uid)) && markAfter();
      allow delete: if false;
      match /marks/{uid} {
        allow read: if isMe(uid);
        allow create: if verified() && isMe(uid)
          && exactKeys(request.resource.data, ['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/goings/$(bucketId)).data.n
             == (exists(/databases/$(database)/documents/goings/$(bucketId)) ? get(/databases/$(database)/documents/goings/$(bucketId)).data.n : 0) + 1;
        allow update, delete: if false;
      }
    }

    // それ以外の場所はすべて禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
